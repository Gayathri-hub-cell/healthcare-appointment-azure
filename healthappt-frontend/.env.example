# Copy this file to ".env" and fill in your real values.
# Vite only exposes variables that start with VITE_.

VITE_SPA_CLIENT_ID=your-spa-app-client-id
VITE_TENANT_ID=your-directory-tenant-id
VITE_API_SCOPE=api://your-healthappt-api-client-id/access_as_user

# Local dev: point at the backend running on port 8080.
# Before building for production, change this to:  /api
VITE_API_BASE=http://localhost:8080/api
