# Copy this file to ".env" and fill in your real values.
# The .env file is for LOCAL development only and must never be committed.

PORT=8080

# Your Azure SQL connection
SQL_SERVER=sql-healthappt-XXXX.database.windows.net
SQL_DATABASE=healthappt

# LOCAL DEV ONLY: use the SQL admin username/password you set when creating the server.
# In Azure (production) you LEAVE THESE BLANK so the app uses its managed identity instead.
SQL_USER=sqladmin
SQL_PASSWORD=your-strong-password

# Microsoft Entra ID values (from your two app registrations)
ENTRA_TENANT_ID=your-directory-tenant-id
API_AUDIENCE=your-healthappt-api-client-id

# Optional: leave blank locally
APPLICATIONINSIGHTS_CONNECTION_STRING=
